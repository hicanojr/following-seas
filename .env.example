# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Agents
ANTHROPIC_API_KEY=
# Optional. Model used by the Scoring agent.
SCORING_MODEL=
APIFY_TOKEN=
USAJOBS_API_KEY=
# The email address the USAJobs key was issued to (sent as User-Agent).
USAJOBS_USER_AGENT=
CRON_SECRET=
