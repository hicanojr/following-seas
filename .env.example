# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or prefix with NEXT_PUBLIC_.
# The JobSpy worker uses this same key. A scheduled run has no signed-in person.
SUPABASE_SERVICE_ROLE_KEY=

# JobSpy worker (GitHub Actions secret, or the VPS). Same project URL as NEXT_PUBLIC_SUPABASE_URL.
# The app itself reads NEXT_PUBLIC_SUPABASE_URL. The worker accepts either name.
SUPABASE_URL=

# Agents. The Scoring agent and the JobSpy resume parser both use this key.
# The parser runs once per resume text and caches the JSON. Optional override: RESUME_PARSE_MODEL.
ANTHROPIC_API_KEY=
# Optional. Model used by the Scoring agent.
SCORING_MODEL=
CHIEF_MODEL=
APIFY_TOKEN=
USAJOBS_API_KEY=
# The email address the USAJobs key was issued to (sent as User-Agent).
USAJOBS_USER_AGENT=
CRON_SECRET=

# JobSpy worker, optional. Defaults are in worker/README.md.
# JOBSPY_RESULTS_WANTED=20
# JOBSPY_HOURS_OLD=72
# JOBSPY_COUNTRY=USA
# JOBSPY_QUERY_CAP=8
# JOBSPY_EMBED_LIMIT=200
# JOBSPY_FETCH_DESCRIPTION=1
# JOBSPY_USER_ID=
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
# RESUME_PARSE_MODEL=claude-haiku-5-5
